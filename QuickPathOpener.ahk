; =================================================================================
; QuickPath Opener - AutoHotkey (v1) 脚本
;
; 功能:
;   - 拦截 Win+E 快捷键。
;   - 检查剪贴板内容是否为一个有效的、已存在的文件夹路径。
;   - 如果是，则使用资源管理器打开该路径。
;   - 如果不是（或剪贴板为空），则执行默认的 Win+E 功能（打开“此电脑”或“快速访问”）。
;
; 支持的路径格式:
;   - D:\folder
;   - "D:\folder"
;   - D:\folder\
;   - "D:\folder\"
;   - 以及路径前后有空格的情况
; =================================================================================

#NoEnv  ; 推荐配置，可提高性能和兼容性。
SendMode Input  ; 推荐配置，提供更可靠的按键发送方式。

; 拦截 Win+E 快捷键
; '$' 前缀是为了防止 Send 命令触发热键自身，避免无限循环。
$#e::
{
    ; 1. 从剪贴板获取纯文本内容
    path := Clipboard

    ; 如果剪贴板为空，直接执行默认功能
    if (path = "")
    {
        Send, #e
        return
    }

    ; 2. 清理和修正路径
    ; a) 移除路径前后的所有空格和制表符
    path := Trim(path)

    ; b) 如果路径被英文双引号包裹，则移除双引号
    if (SubStr(path, 1, 1) = """" and SubStr(path, 0) = """")
    {
        StringTrimLeft, path, path, 1
        StringTrimRight, path, path, 1
    }

    ; 3. 验证路径是否存在并且是一个文件夹
    ; FileExist() 会返回一个空字符串如果文件或文件夹不存在。
    ; 如果存在，它会返回其属性。我们检查返回的属性中是否包含 "D" (Directory)。
    if InStr(FileExist(path), "D")
    {
        ; 4a. 如果是有效文件夹路径，则用资源管理器打开它
        ; Run 命令中的 "%path%" 可以确保带空格的路径被正确处理
        Run, explorer.exe "%path%"
    }
    else
    {
        ; 4b. 如果不是有效文件夹路径，则执行原始的 Win+E 功能
        Send, #e
    }
    return
}